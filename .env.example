# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=fyp_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fyp_db
DATABASE_URL=postgresql+asyncpg://fyp_user:change-me@localhost:5432/fyp_db

# ── Backend ───────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
MODEL_PATH=ml/models/xgboost_phishing.pkl
FEATURE_COLUMNS_PATH=ml/models/feature_columns.json
# Origin(s) allowed to call the API cross-origin (CORS) — the dashboard, not the extension (the
# extension is exempt from CORS via manifest.json's host_permissions). Comma-separated for
# multiple origins, e.g. once deployed: https://esa-dashboard.vercel.app
DASHBOARD_ORIGIN=http://localhost:3000

# ── External APIs ─────────────────────────────────────────────
# Get a free key at: https://www.virustotal.com/gui/sign-in
# Free tier: 4 requests/minute, 500 requests/day
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# ── Dashboard ─────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ── Environment ───────────────────────────────────────────────
ENVIRONMENT=development
