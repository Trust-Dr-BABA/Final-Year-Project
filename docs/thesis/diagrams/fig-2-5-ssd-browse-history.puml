@startuml fig-2-5-ssd-browse-history
' Figure 2.5 — System sequence diagram, UC-05 / UC-06 / UC-07 dashboard interactions
!theme plain
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12

actor "Web User" as User
participant ":System" as System

User -> System : requestOverview(clientId)
activate System
note right : clientId absent -> zeroed statistics,\nno query issued (never every browser's data)
System --> User : statistics { totalScans, phishingCount,\nsuspiciousCount, legitimateCount, avgConfidencePct }
deactivate System

User -> System : requestHistory(limit, offset, clientId)
activate System
note right : clientId absent -> empty page, no query issued
System --> User : page { scans[], total, limit, offset }
deactivate System

User -> System : requestScanDetail(scanId, clientId)
activate System
alt clientId is absent
  System --> User : error 422 "clientId required"
else scanId is malformed
  System --> User : error 400 "Invalid scan_id"
else no such record, or clientId does not own it
  System --> User : error 404 "Scan not found"
else scanId is well-formed and clientId owns the record
  System --> User : scan { url, verdict, riskScore, riskPct, confidencePct,\nurlFeatures, networkSignals, permissionSignals,\nscamContentSignals, attributions, flaggedRules,\ncreatedAt, lastScannedAt }
end
deactivate System
@enduml
