# Only needed to override the defaults (localhost:8000 backend, localhost:3100 dashboard).
# Copy to .env and adjust if your backend/Postgres run somewhere else.

E2E_BACKEND_URL=http://localhost:8000
E2E_BASE_URL=http://localhost:3100

# Required only for global-teardown's cleanup query (DELETE FROM scans WHERE client_id LIKE
# 'e2e-%'). Not required for correctness — every test seeds a unique client_id — only for keeping
# a local dev database tidy across repeated runs. Same value as the root .env's DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://fyp_user:change-me@localhost:5432/fyp_db
