# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# ML model artifacts (large binary files)
ml/models/*.pkl
ml/models/*.joblib


# Environment secrets
.env
!.env.example

# Node
node_modules/
.next/
dist/
out/

# IDEs
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# Jupyter checkpoints
.ipynb_checkpoints/

# Docker overrides
docker-compose.override.yml

# Thesis build artefacts — regenerate with docs/thesis/build.sh
docs/thesis/out/
docs/thesis/diagrams/plantuml.jar

# ...but keep the rendered diagrams: the chapter markdown embeds them, and they
# should be readable without a local JDK. The generic `out/` rule above catches
# them otherwise, and a directory must be re-included before its contents can be.
!docs/thesis/diagrams/out/
!docs/thesis/diagrams/out/*.png


# ///////
# Generated Word style definitions — rebuild with make_reference.py
docs/thesis/reference.docx
